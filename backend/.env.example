DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nlsql_demo
OPENAI_API_KEY=your-openai-api-key-here
MAX_ROWS_RETURNED=100
QUERY_TIMEOUT_SECONDS=5
DB_SSLMODE=prefer
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nlsql_auth
# Optional fallback only if AUTH_DATABASE_URL is not set:
AUTH_DB_PATH=./data/auth.db
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440
STARTING_CREDITS=25
CREDITS_PER_QUERY=1
MAX_QUESTION_CHARS=500
MAX_QUESTION_WORDS=80
SCHEMA_CONTEXT_MAX_CHARS=12000
SQL_GENERATION_MAX_TOKENS=220
EXPLANATION_MAX_TOKENS=180
MAX_GENERATED_SQL_CHARS=3000
MAX_SUMMARY_CHARS=1200
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE_USER=12
RATE_LIMIT_PER_MINUTE_IP=40
DAILY_QUERY_LIMIT_PER_USER=120
REDIS_STRICT_MODE=true
PASSWORD_HASH_ITERATIONS=210000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
PASSWORD_AUTH_ENABLED=false
